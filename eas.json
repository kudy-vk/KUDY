{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "sandbox": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SANDBOX": "1"
      },
      "android": {
        "buildType": "apk",
        "autoIncrement": true
      }
    },
    "production": {}
  },
  "submit": {
    "production": {}
  }
}
